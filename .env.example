# ---------------------------------------------------------------
# Public site URL (used for canonical URLs, sitemap, Open Graph)
# ---------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=https://www.happiclinic.in

# ---------------------------------------------------------------
# Appointment enquiry delivery. Configure AT LEAST ONE channel.
# If none is configured the form shows an error and asks people
# to call; it never shows a false "received" message.
# ---------------------------------------------------------------

# Option A: email via Resend (https://resend.com). The FROM address
# must be on a domain you have verified in Resend.
RESEND_API_KEY=
ENQUIRY_TO_EMAIL=
ENQUIRY_FROM_EMAIL="HAPPI Clinic Website <enquiries@happiclinic.in>"

# Option B: HTTPS webhook (e.g. a Google Apps Script that appends
# to a private Google Sheet, or the clinic's own system). The secret
# is sent in the X-Webhook-Secret header.
ENQUIRY_WEBHOOK_URL=
ENQUIRY_WEBHOOK_SECRET=

# ---------------------------------------------------------------
# Spam protection (optional but recommended): Cloudflare Turnstile.
# Honeypot, timing check, server validation and rate limiting run
# regardless.
# ---------------------------------------------------------------
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# ---------------------------------------------------------------
# Content admin (Keystatic). Leave the repo blank for local editing
# in development. In production the admin at /keystatic is only
# enabled when GitHub mode is configured.
# ---------------------------------------------------------------
NEXT_PUBLIC_KEYSTATIC_GITHUB_REPO=
KEYSTATIC_GITHUB_CLIENT_ID=
KEYSTATIC_GITHUB_CLIENT_SECRET=
KEYSTATIC_SECRET=
NEXT_PUBLIC_KEYSTATIC_GITHUB_APP_SLUG=

# Show placeholder doctor cards for an owner preview build only.
NEXT_PUBLIC_SHOW_PLACEHOLDERS=false

# ---------------------------------------------------------------
# Live appointments and password-protected /admin (Supabase)
# ---------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Secret: Vercel server-side environment only. NEVER prefix NEXT_PUBLIC_!
SUPABASE_SERVICE_ROLE_KEY=
